# Polybot configuration
# Copy to .env and adjust values

# Runtime mode — readonly or paper (live is blocked until security audit)
POLYBOT_MODE=readonly

# Gamma API (market discovery)
POLYBOT_GAMMA_BASE_URL=https://gamma-api.polymarket.com
POLYBOT_GAMMA_RATE_LIMIT_RPS=2

# CLOB API (orderbook data)
POLYBOT_CLOB_BASE_URL=https://clob.polymarket.com
POLYBOT_CLOB_RATE_LIMIT_RPS=5

# WebSocket
POLYBOT_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYBOT_WS_RECONNECT_DELAY_MS=1000
POLYBOT_WS_RECONNECT_MAX_DELAY_MS=30000
POLYBOT_WS_PING_INTERVAL_MS=30000

# Recorder
POLYBOT_RECORDER_DIR=data/recordings
POLYBOT_RECORDER_MAX_FILE_SIZE_MB=50

# Streaming
# POLYBOT_STREAMING_MARKET_COUNT=3

# Logging
POLYBOT_LOG_LEVEL=info
POLYBOT_LOG_DIR=logs

# Paper trading (only used when POLYBOT_MODE=paper)
# POLYBOT_PAPER_INITIAL_BALANCE=1000
# POLYBOT_PAPER_MAX_POSITION_SIZE=100
# POLYBOT_PAPER_MAX_OPEN_POSITIONS=5
# POLYBOT_PAPER_FEE_RATE=0.05
# POLYBOT_PAPER_TICK_SIZE=0.01
# POLYBOT_PAPER_MIN_ORDER_SIZE=1
# POLYBOT_PAPER_STALE_BOOK_MS=30000
